# Supabase (proyecto del negocio/plataforma)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo para scripts server-side de administración (nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Lemon Squeezy / Stripe (licencia única $7 USD que cobra la plataforma)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Nota: el access token de Mercado Pago de CADA NEGOCIO no va acá — se
# configura por negocio desde /admin y se guarda en la tabla
# business_payment_settings (ver sql/schema.sql). SUPABASE_SERVICE_ROLE_KEY
# de arriba es lo que permite a src/app/api/checkout/mercadopago/route.ts
# leerlo en el servidor.
