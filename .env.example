# Database
POSTGRES_DB=autix_core
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Core Server
PORT=4000
DISABLE_AUTH=true
NODE_ENV=production

# Campolac Connector
CONNECTOR_PORT=4200
CORE_SERVER_URL=http://localhost:4000

# OAuth (production only)
OAUTH_ISSUER=https://your-auth-provider.com
OAUTH_JWKS_URI=https://your-auth-provider.com/.well-known/jwks.json
OAUTH_AUDIENCE=autix-api
